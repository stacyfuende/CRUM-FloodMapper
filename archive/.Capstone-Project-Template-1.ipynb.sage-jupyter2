{"cell_type":"code","end":1773012862839,"exec_count":7,"id":"4b6a03","input":"#analysing population exposure\n\n#create population grid \npopulation_grid <- flood_counts %>%\n  distinct(cell_x, cell_y)%>%\n  mutate(geometry = purrr::map2(cell_x, cell_y, ~{\n      st_polygon(list(matrix(c(.x, .y,\n                              .x + grid_size, .y,\n                              .x + grid_size, .y + grid_size,\n                               .x, .y + grid_size,\n                               .x, .y\n                              ), ncol = 2, byrow = TRUE)))\n  })\n        )%>%\n  st_as_sf(crs = st_crs(pop_clip))\n#plot(population_grid)\n\n#extract sum of population per grid cell\npopulation_grid$population <- \nexact_extract(\n  pop_clip,\n  population_grid,\n  fun = \"sum\",\n  progress = FALSE\n)\n\n#replavce NA with 0\npopulation_grid$population <- replace_na(population_grid$population,0)\n\n\n#join population to xisting flood frequency analysis\nflood_population <- flood_counts %>%\n  left_join(st_drop_geometry(population_grid),\n           by = c(\"cell_x\", \"cell_y\")\n           )%>%\n mutate(population_exposed = population * flood_frequency,\n       risk_category = case_when(flood_frequency >= 10 & population > 100 ~ \"CRITICAL: Dense Chronic\",\n                                flood_frequency >= 10 ~ \"HIGH: Chronic Flood Zone\",\n                                flood_frequency >= 5 & population > 50 ~ \"ELEVATED: Populated Repeat\",\n                                flood_frequency >= 5 ~ \"MODERATE: Repeat Flooding\",\n                                flood_frequency >= 2 & population > 0 ~ \"LOW: Some Population\",\n                                population > 0 ~ \"Minimal: Single Event\",\n                                TRUE ~ \"UNPOPULATED\"\n                                )\n       )\nhead(flood_population)\n\n#calculate key metrics\nkey_metrics <- flood_population %>%\n  summarise(\n  total_population_at_risk = sum(population[flood_frequency > 0], na.rm = TRUE),\n  chronic_population = sum(population[flood_frequency >= 10], na.rm = TRUE),\n  high_risk_population = sum(population[flood_frequency >= 5], na.rm = TRUE),\n  total_person_flood_events = sum(population_exposed, na.rm = TRUE),\n  avg_people_per_chronic_cell = mean(population[flood_frequency >= 10], na.rm = TRUE),\n  most_vulnerable_cell_pop = max(population[flood_frequency >= 10], na.rm = TRUE)\n  )\nprint(key_metrics)","kernel":"ir","last":9534,"output":{"0":{"data":{"application/geo+json":{"features":[{"geometry":{"coordinates":[263873.7772,9863810.9552],"type":"Point"},"properties":{"cell_x":263800,"cell_y":9863800,"first_flood":"2016-05-21","flood_frequency":1,"last_flood":"2016-05-21","population":53.7753,"population_exposed":53.7753,"risk_category":"Minimal: Single Event","unique_locations":1},"type":"Feature"},{"geometry":{"coordinates":[263989.6833,9863849.2455],"type":"Point"},"properties":{"cell_x":263900,"cell_y":9863800,"first_flood":"2018-07-20","flood_frequency":1,"last_flood":"2018-07-20","population":67.2144,"population_exposed":67.2144,"risk_category":"Minimal: Single Event","unique_locations":1},"type":"Feature"},{"geometry":{"coordinates":[265574.1029,9863898.3774],"type":"Point"},"properties":{"cell_x":265500,"cell_y":9863800,"first_flood":"2016-05-31","flood_frequency":1,"last_flood":"2016-05-31","population":180.1426,"population_exposed":180.1426,"risk_category":"Minimal: Single Event","unique_locations":1},"type":"Feature"},{"geometry":{"coordinates":[[265574.0872,9863918.3003],[265594.4714,9863918.3164]],"type":"MultiPoint"},"properties":{"cell_x":265500,"cell_y":9863900,"first_flood":"2016-05-31","flood_frequency":2,"last_flood":"2016-05-31","population":94.2869,"population_exposed":188.5738,"risk_category":"LOW: Some Population","unique_locations":2},"type":"Feature"},{"geometry":{"coordinates":[265904.5982,9864309.6611],"type":"Point"},"properties":{"cell_x":265900,"cell_y":9864300,"first_flood":"2018-02-22","flood_frequency":