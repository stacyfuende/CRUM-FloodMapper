{"cell_type":"code","exec_count":0,"id":"a4ef07","input":"# Analysis: Trends in fuel economy by vehicle class\nfuel_economy_trends <- mpg_clean %>%\n    group_by(class) %>%\n    summarize(mean_hwy = mean(hwy))\n\n# Visualization\nggplot(fuel_economy_trends, aes(x = class, y = mean_hwy)) +\n  geom_bar(stat = \"identity\") +\n  labs(title = \"Average Highway Fuel Economy by Vehicle Class\", x = \"Vehicle Class\", y = \"Average Highway MPG\") +\n  theme_minimal()","pos":8,"type":"cell"}
{"cell_type":"code","exec_count":0,"id":"ce04e2","input":"# Additional visualizations to explore relationships\nggplot(mpg_clean, aes(x = displ, y = hwy)) +\n  geom_point() +\n  labs(title = \"Impact of Engine Size on Highway Fuel Economy\", x = \"Engine Displacement (liters)\", y = \"Highway MPG\") +\n  theme_minimal()\n\n# Summary of fuel economy by manufacturer\nfuel_economy_manufacturer <- mpg_clean %>%\n    group_by(manufacturer) %>%\n    summarize(mean_hwy = mean(hwy), mean_cty = mean(cty))\n\nfuel_economy_manufacturer %>%\n    arrange(desc(mean_hwy))\n\n# Visualization of fuel economy by manufacturer\nggplot(fuel_economy_manufacturer, aes(x = reorder(manufacturer, -mean_hwy), y = mean_hwy)) +\n  geom_bar(stat = \"identity\") +\n  labs(title = \"Average Highway Fuel Economy by Manufacturer\", x = \"Manufacturer\", y = \"Average Highway MPG\") +\n  theme_minimal() +\n  coord_flip()","pos":10,"type":"cell"}
